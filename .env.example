# Supabase — copy this file to .env and fill in your values
# Get these from: Supabase dashboard > Project Settings > API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Service-role key — admin access, bypasses RLS. Used ONLY by
# scripts/clean-test-fixtures.ts (npm run db:clean-fixtures).
# Get from Supabase dashboard > Project Settings > API > service_role.
# Never commit a populated .env, never expose this key in the
# frontend bundle (it's not VITE_-prefixed for that reason).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Cloudflare Turnstile site key — public, baked into the contact
# form bundle. Get from the Cloudflare dashboard > Turnstile > your
# site widget. The matching *secret* key is set as a Supabase
# secret (TURNSTILE_SECRET_KEY) for the contact-form-submit edge
# function and is never bundled into the frontend.
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key-here

# vCard app Supabase project — read-only access to the hosted-vCard
# contact data via its public anon RPCs (lookup_card_by_slug etc.).
# Same values as the vCard public site's SUPABASE_URL /
# SUPABASE_PUBLISHABLE_KEY. The proof viewer calls these RPCs from
# the designer's URL-paste validator and from the customer-side QR
# verification panel; both contexts are anon, so the publishable
# key is correct and safe to bake into the frontend bundle.
VITE_VCARD_SUPABASE_URL=https://your-vcard-project-ref.supabase.co
VITE_VCARD_SUPABASE_ANON_KEY=your-vcard-anon-key-here
