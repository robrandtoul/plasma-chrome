# Supabase — copy this file to .env and fill in your values
# Get these from: Supabase dashboard > Project Settings > API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Service-role key — admin access, bypasses RLS. Used ONLY by
# scripts/clean-test-fixtures.ts (npm run db:clean-fixtures).
# Get from Supabase dashboard > Project Settings > API > service_role.
# Never commit a populated .env, never expose this key in the
# frontend bundle (it's not VITE_-prefixed for that reason).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
