{
  "name": "proof-viewer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --config vite.price-list.config.ts && vite build --config vite.contact-form.config.ts",
    "build:price-list": "vite build --config vite.price-list.config.ts",
    "build:contact-form": "vite build --config vite.contact-form.config.ts",
    "preview": "vite preview",
    "db:diff": "tsx scripts/db-diff.ts",
    "db:push:confirm": "tsx scripts/db-push-confirm.ts",
    "db:status": "npx supabase migration list --linked",
    "db:clean-fixtures": "tsx scripts/clean-test-fixtures.ts",
    "db:empty-proof-images": "tsx scripts/empty-proof-images-bucket.ts",
    "check:price-list": "tsx scripts/check-price-list-golden.ts",
    "check:briefing-seed": "tsx scripts/briefing-seed.ts --check",
    "test:quote": "tsx src/lib/quote/interpolation.test.ts && tsx src/lib/quote/calculate.test.ts",
    "test:order-pricing": "tsx supabase/functions/_shared/orderPricing.test.ts",
    "test:nudges": "tsx supabase/functions/_shared/nudgeDecision.test.ts",
    "backtest": "tsx scripts/run-backtest.ts",
    "test:ai-drafts": "tsx supabase/functions/_shared/aiDrafts/guardrails.test.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.49.4",
    "@zxing/library": "^0.23.0",
    "jszip": "^3.10.1",
    "lucide-react": "~0.439.0",
    "qrcode": "1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.5.3",
    "react-virtuoso": "^4.18.6",
    "uuid": "^13.0.0",
    "xlsx": "^0.18.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.4",
    "@types/node": "^25.6.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/uuid": "^11.0.0",
    "@vitejs/plugin-react": "^4.4.1",
    "dotenv": "^17.4.2",
    "tailwindcss": "^4.1.4",
    "tsx": "^4.21.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.2"
  }
}
