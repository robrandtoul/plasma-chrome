# dependencies
node_modules/
.pnpm-store/

# build output
dist/
dist-ssr/

# environment variables — never commit these
.env
.env.local
.env.production

# Claude Code local settings, plugins, and session scratch
.claude/

# editor and OS
.DS_Store
*.local
.vscode/
.idea/

# Vite
*.tsbuildinfo

